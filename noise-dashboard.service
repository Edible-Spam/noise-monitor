[Unit]
Description=Noise Monitor Dashboard
After=network.target noise-monitor.service
Wants=noise-monitor.service

[Service]
Type=simple
User=spam
Group=spam
WorkingDirectory=/home/spam/noise-monitor
ExecStart=/home/spam/noise-monitor/.venv/bin/python /home/spam/noise-monitor/main.py dashboard --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
